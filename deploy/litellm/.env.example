# Copy to deploy/litellm/.env and `source` it before starting the Python proxy.
# Never commit real keys.

# LiteLLM proxy master key (C2 sends this as LLM_API_KEY).
LITELLM_MASTER_KEY=sk-litellm-local
LITELLM_PORT=4000

# Cloud backends — live smoke/tests use Gemini 3.8 Flash (GEMINI_API_KEY).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FIREWORKS_AI_API_KEY=

# Optional local OpenAI-compatible backends on the same host as the proxy.
OLLAMA_API_BASE=http://127.0.0.1:11434
VLLM_API_BASE=http://127.0.0.1:8000/v1
VLLM_API_KEY=sk-vllm-local
