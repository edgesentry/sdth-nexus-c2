# Copy to deploy/litellm/.env for docker compose interpolation (never commit real keys).
# Compose also reads host-exported GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY.

# LiteLLM proxy master key (C2 sends this as LLM_API_KEY).
LITELLM_MASTER_KEY=sk-litellm-local
LITELLM_PORT=4000

# Cloud backends — live smoke/tests use Gemini 3.8 Flash (GEMINI_API_KEY).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional local OpenAI-compatible backends (host services, not in this compose).
OLLAMA_API_BASE=http://host.docker.internal:11434
VLLM_API_BASE=http://host.docker.internal:8000/v1
VLLM_API_KEY=sk-vllm-local
