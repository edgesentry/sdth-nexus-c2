# Copy to .env — never commit real keys.
# Used by sdth-c2-server when talking to LiteLLM (deploy/litellm/).

LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_API_KEY=sk-litellm-local
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_S=8

# Optional: Cloudflare Worker shared Bearer (issue #38).
# Only needed when C2_BASE_URL points at workers.dev / wrangler with C2_API_TOKEN set.
# C2_API_TOKEN=

# Optional: Sentinel-Imagery-Analysis sibling upstream (issue #47).
# Pattern B: run upstream on :5050; C2 pull_upstream falls back to fixture if down.
# SAR_UPSTREAM_URL=http://127.0.0.1:5050
# SAR_UPSTREAM_SCAN=sg_strait_s1_20260918
# SAR_UPSTREAM_TIMEOUT_S=3
# AIS_SOURCE=demo
# INDAGO_AIS_DUCKDB=~/.indago/data/processed/ais/singapore.duckdb
# SENTINEL_DATABASE_PATH=~/work/Sentinel-Imagery-Analysis/data.db

# Optional: open AIS / open air fixtures on CLI (issue #16). Unset = synthetic-only.
# OPEN_FEED=ais,air

# Optional stretch: Screen 2 client blinks RasPi GPIO after Ack (issue #20).
# Set on the laptop/Pi that has the LED — not on Cloudflare Core.
# No-op without RPi.GPIO / hardware.
# RASPI_ACK_BLINK=1
# RASPI_LED_PIN=17

CLOUDFLARE_ACCOUNT_ID=xxx
CLOUDFLARE_API_TOKEN=xxx
C2_API_TOKEN=xxx
